{
  "description": "What CNA-TS depends on at the CNA C ABI boundary, stated once so it can be proved against the canonical headers instead of restated in prose. tools/cna-abi/verify-contract.mjs generates a C translation unit from this file and compiles it against CNA/C/*.h under -Wall -Wextra -Werror, so an absent constant, a changed value, a changed scalar width or a changed struct version is a compile error rather than a silent runtime mismatch.",
  "scalarRepresentations": [
    {
      "expression": "sizeof(CNA_Bool)",
      "value": 1,
      "reason": "the ABI fixes CNA_Bool as uint8_t"
    },
    {
      "expression": "sizeof(CNA_Handle)",
      "value": 8,
      "reason": "the ABI fixes CNA_Handle as uint64_t; the adapter carries it as a JavaScript bigint"
    },
    {
      "expression": "sizeof(CNA_Result)",
      "value": 4,
      "reason": "the ABI fixes CNA_Result as uint32_t"
    },
    {
      "expression": "(uint32_t) CNA_FALSE",
      "value": 0,
      "reason": "the only two canonical CNA_Bool bytes"
    },
    {
      "expression": "(uint32_t) CNA_TRUE",
      "value": 1,
      "reason": "the only two canonical CNA_Bool bytes"
    },
    {
      "expression": "(uint64_t) CNA_INVALID_HANDLE",
      "value": 0,
      "reason": "the adapter treats 0n as the absent handle"
    }
  ],
  "resultCodes": {
    "reason": "the adapter maps these onto XNA and CNA error identities, so their numbers are part of the contract",
    "constants": {
      "CNA_RESULT_SUCCESS": 0,
      "CNA_RESULT_INVALID_ARGUMENT": 1,
      "CNA_RESULT_INVALID_HANDLE": 2,
      "CNA_RESULT_INVALID_STATE": 3,
      "CNA_RESULT_OUT_OF_MEMORY": 4,
      "CNA_RESULT_IO": 5,
      "CNA_RESULT_NOT_SUPPORTED": 6,
      "CNA_RESULT_PLATFORM": 7,
      "CNA_RESULT_THREAD": 8,
      "CNA_RESULT_CALLBACK": 9,
      "CNA_RESULT_OVERFLOW": 10,
