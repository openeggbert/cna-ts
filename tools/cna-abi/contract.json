      "CNA_RESULT_INTERNAL": 12,
      "CNA_RESULT_SHUTTING_DOWN": 13,
      "CNA_RESULT_BUFFER_TOO_SMALL": 14
    }
  },
  "structVersions": {
    "reason": "every versioned descriptor the adapter fills sets struct_version to 1; where the headers publish a macro for that version, the macro is asserted rather than assumed",
    "declared": {
