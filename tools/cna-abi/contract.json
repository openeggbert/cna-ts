    }
  },
  "adapterStructVersionLiteral": 1,
  "managedEnums": {
    "ButtonState": "XNA's pressed/released identity is carried across the C ABI as a CNA_Bool rather than as an identity of its own, so there is no constant family for it to agree with"
  },
